PORT = #Add port

# URL used by the browser to reach the API (through Nginx or tunnel)
VITE_API_URL = http://localhost:8000

# URL used by SSR loaders to reach the API directly (VM-to-VM, bypasses Nginx)
# Required when VITE_API_URL routes through a proxy that is not reachable server-side
VITE_INTERNAL_API_URL = http://<backend-ip>:8000